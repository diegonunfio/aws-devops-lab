{
  "name": "aws-devops-lab-api",
  "version": "1.0.0",
  "description": "REST API for aws-devops-lab — CI/CD, Docker, Terraform, ECS, K8s demo",
  "author": "Diego Nunfio <diegonunfio@github.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/diegonunfio/aws-devops-lab.git"
  },
  "license": "MIT",
  "main": "src/index.js",
  "scripts": {
    "start":    "node src/index.js",
    "dev":      "nodemon src/index.js",
    "test":     "jest --coverage --forceExit",
    "test:ci":  "jest --coverage --forceExit --ci --reporters=default --reporters=jest-junit",
    "lint":     "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix"
  },
  "dependencies": {
    "express":     "^4.18.2",
    "morgan":      "^1.10.0",
    "prom-client": "^15.1.0"
  },
  "devDependencies": {
    "eslint":    "^8.54.0",
    "jest":      "^29.7.0",
    "jest-junit": "^16.0.0",
    "nodemon":   "^3.0.1",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": ["src/**/*.js"],
    "coverageThreshold": {
      "global": {
        "branches":   70,
        "functions":  60,
        "lines":      80,
        "statements": 80
      }
    }
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
